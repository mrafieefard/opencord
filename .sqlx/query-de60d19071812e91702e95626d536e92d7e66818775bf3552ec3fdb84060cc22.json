  "query": "SELECT id, sha256, size_bytes, filename, title, artist, duration_ms, uploader_id,\n                 created_at\n          FROM music_local_songs\n          WHERE id < $1\n            AND LOWER(title || ' ' || artist || ' ' || filename) LIKE $2 ESCAPE '\\'\n          ORDER BY id DESC\n          LIMIT $3",
