  "query": "SELECT id, sha256, size_bytes, filename, title, artist, duration_ms,\n                         uploader_id, created_at\n                  FROM music_local_songs\n                  WHERE LOWER(title || ' ' || artist || ' ' || filename) LIKE $1 ESCAPE '\\'\n                  ORDER BY id DESC\n                  LIMIT $2",
