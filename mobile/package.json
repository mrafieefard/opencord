{
  "name": "opencord-mobile",
  "version": "0.0.1",
  "private": true,
  "license": "MPL-2.0",
  "main": "expo-router/entry",
  "workspaces": [
    "packages/*",
    "modules/*"
  ],
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "android:fake": "EXPO_PUBLIC_FAKE_CORE=1 expo run:android",
    "ios": "expo run:ios",
    "emulator": "scripts/emulator.sh",
    "core:android": "scripts/build-core.sh android",
    "core:ios": "scripts/build-core.sh ios",
    "core:bindings": "scripts/build-core.sh bindings",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "jest",
    "licenses:check": "node scripts/licenses.js",
    "icons": "scripts/make-icons.sh"
  },
  "dependencies": {
    "@expo/ui": "~58.0.23",
    "@opencord/core-native": "0.0.1",
    "@react-native-menu/menu": "2.0.0",
    "@shopify/flash-list": "2.3.2",
    "expo": "~58.0.19",
    "expo-audio": "~58.0.10",
    "expo-build-properties": "~58.0.11",
    "expo-clipboard": "~58.0.4",
    "expo-constants": "~58.0.13",
    "expo-document-picker": "~58.0.4",
    "expo-file-system": "~58.0.11",
    "expo-font": "~58.0.10",
    "expo-haptics": "~58.0.7",
    "expo-image": "~58.0.17",
    "expo-image-picker": "~58.0.10",
    "expo-linking": "~58.0.14",
    "expo-router": "~58.0.26",
    "expo-secure-store": "~58.0.2",
    "expo-sharing": "~58.0.20",
    "expo-splash-screen": "~58.0.11",
    "expo-status-bar": "~58.0.4",
    "expo-symbols": "~58.0.4",
    "expo-system-ui": "~58.0.6",
    "react": "19.3.0",
    "react-native": "0.88.0",
    "react-native-gesture-handler": "~3.3.0",
    "react-native-keyboard-controller": "1.22.7",
    "react-native-reanimated": "4.7.1",
    "react-native-safe-area-context": "~5.10.1",
    "react-native-screens": "~4.30.0",
    "react-native-worklets": "0.13.0",
    "zustand": "5.0.16"
  },
  "devDependencies": {
    "@babel/core": "^7.28",
    "@react-native/jest-preset": "0.88.0",
    "@testing-library/react-native": "14.1.0",
    "@types/jest": "30.0.0",
    "@types/node": "^22",
    "@types/react": "~19.3.0",
    "eslint": "^9",
    "eslint-config-expo": "~58.0.4",
    "jest": "^30",
    "jest-expo": "~58.0.12",
    "typescript": "~6.0.3"
  }
}
